# Template for .env (which is GITIGNORED). Copy this to .env and fill in the values:
#   cp .env.example .env
# Fetch the publishable key:  supabase projects api-keys --project-ref xkobcymztzpievdxchqc
# (run from ~/code/insider-trading-app — same Supabase project the iOS app uses)
#
# Astro exposes PUBLIC_-prefixed vars to client-side code at build time. The
# publishable key is safe to embed (RLS, not key secrecy, protects data).
PUBLIC_SUPABASE_URL=https://xkobcymztzpievdxchqc.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
