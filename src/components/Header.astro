---
import Button from '@components/Button.astro';
import {ABOUT, SERVICES, EXPERIENCE, CONTACT} from '@lib/constants';
import BurgerIcon from 'src/assets/BurgerIcon.astro';
import CloseIcon from 'src/assets/CloseIcon.astro';

const BUTTONS_CONTENT = {
  about: {name: 'About', href: `#${ABOUT}`},
  services: {name: 'Services', href: `#${SERVICES}`},
  experience: {name: 'Experience', href: `#${EXPERIENCE}`},
  signals: {name: 'Insider Signals', href: '/insider-trading-signals'},
  contact: {name: 'Stay in touch', href: `#${CONTACT}`},
};
---

<div
  id="container"
  class="sticky top-0 z-[1000] w-full flex justify-center px-[16px] pt-[8px] pb-[8px] lg:pt-[24px]"
>
  <header
    class="max-w-[1200px] w-full bg-bg-secondary/50 rounded-[24px] lg:rounded-[32px] p-[8px] pl-[16px] lg:px-[16px] lg:py-[12px] backdrop-blur-[14px]"
  >
    <div class="flex w-full flex-col">
      <div class="flex items-center justify-between w-full">
        <a
          href="/"
          class="font-serif font-semibold text-h6 lg:text-h5 text-color-main"
          >Bill Leece</a
        >

        <nav class="flex items-center justify-center">
          <div class="hidden lg:flex flex-nowrap gap-x-[8px]">
            <Button
              text={BUTTONS_CONTENT.about.name}
              href={BUTTONS_CONTENT.about.href}
              variant="link"
              size="md"
            />
            <Button
              text={BUTTONS_CONTENT.services.name}
              href={BUTTONS_CONTENT.services.href}
              variant="link"
              size="md"
            />
            <Button
              text={BUTTONS_CONTENT.experience.name}
              href={BUTTONS_CONTENT.experience.href}
              variant="link"
              size="md"
            />
            <Button
              text={BUTTONS_CONTENT.signals.name}
              href={BUTTONS_CONTENT.signals.href}
              variant="link"
              size="md"
            />
          </div>
        </nav>

        <div class="flex items-center">
          <a
            href={BUTTONS_CONTENT.contact.href}
            class="hidden lg:flex items-center justify-center h-[40px] px-[16px] text-h6 font-bold rounded-[16px] text-white bg-gradient-to-br from-accent-blue to-accent-green hover:brightness-110 transition-[filter]"
          >
            {BUTTONS_CONTENT.contact.name}
          </a>

          <button id="burgerOpenBtn" class="lg:hidden ml-[16px]">
            <BurgerIcon />
          </button>
          <button id="burgerCloseBtn" class="lg:hidden hidden ml-[16px]">
            <CloseIcon />
          </button>
        </div>
      </div>

      <div
        id="burgerMenu"
        class="lg:hidden hidden flex items-center flex-col mt-[16px]"
      >
        <Button
          text={BUTTONS_CONTENT.about.name}
          href={BUTTONS_CONTENT.about.href}
          variant="link"
          size="md"
        />
        <Button
          text={BUTTONS_CONTENT.services.name}
          href={BUTTONS_CONTENT.services.href}
          variant="link"
          size="md"
        />
        <Button
          text={BUTTONS_CONTENT.experience.name}
          href={BUTTONS_CONTENT.experience.href}
          variant="link"
          size="md"
        />
        <Button
          text={BUTTONS_CONTENT.signals.name}
          href={BUTTONS_CONTENT.signals.href}
          variant="link"
          size="md"
        />
        <Button
          text={BUTTONS_CONTENT.contact.name}
          href={BUTTONS_CONTENT.contact.href}
          variant="link"
          size="md"
        />
      </div>
    </div>
  </header>
</div>

<script>
  const burgerOpenBtn = document.getElementById('burgerOpenBtn');
  const closeBtn = document.getElementById('burgerCloseBtn');
  const burgerMenu = document.getElementById('burgerMenu');
  const container = document.getElementById('container');

  burgerOpenBtn.addEventListener('click', function () {
    burgerOpenBtn.classList.add('hidden');
    closeBtn.classList.remove('hidden');
    burgerMenu.classList.remove('hidden');
    container.classList.add('mb-[-176px]');
  });

  const handleCloseMenu = function () {
    closeBtn.classList.add('hidden');
    burgerOpenBtn.classList.remove('hidden');
    burgerMenu.classList.add('hidden');
    container.classList.remove('mb-[-176px]');
  };

  closeBtn.addEventListener('click', handleCloseMenu);

  const menuButtons = burgerMenu.querySelectorAll('button, a');
  menuButtons.forEach(button => {
    button.addEventListener('click', handleCloseMenu);
  });
</script>
