---
const STATS: {value: string; label: string; from: string; to: string}[] = [
  {
    value: '$10B+',
    label: 'aggregate margin impact, Google CRM',
    from: '#3890C2',
    to: '#2CBDDA',
  },
  {
    value: '30%+',
    label: 'AI agent goal-completion improvement',
    from: '#3890C2',
    to: '#2CBDDA',
  },
  {
    value: '$0→$15M',
    label: 'revenue built as founding VP Product',
    from: '#2CBDDA',
    to: '#22A06B',
  },
  {
    value: '2',
    label: 'granted US patents',
    from: '#2CBDDA',
    to: '#22A06B',
  },
  {
    value: 'OpenAI',
    label: 'former Red Team contributor',
    from: '#3890C2',
    to: '#22A06B',
  },
];
---

<div class="w-full bg-bg-surface border-y border-white/10">
  <div
    class="max-w-[1120px] mx-auto px-[16px] lg:px-[40px] py-[32px] lg:py-[44px] grid grid-cols-2 lg:grid-cols-5 gap-[28px]"
  >
    {
      STATS.map(stat => (
        <div class="flex flex-col gap-[6px]">
          <div
            class="stat-value font-serif font-semibold text-[26px] lg:text-[30px]"
            style={`background-image: linear-gradient(90deg, ${stat.from}, ${stat.to});`}
          >
            {stat.value}
          </div>
          <div class="text-h7 leading-[1.4] text-text-secondary">
            {stat.label}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .stat-value {
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
