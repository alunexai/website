---
import GoogleTagManager from '@components/GoogleTagManager.astro';

export interface Props {
  title: string;
}

const {title} = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Bill Leece — product management and applied AI. Fractional product leadership, AI strategy consulting, applied AI building, and advisory work."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <GoogleTagManager />
  </head>
  <body>
    <slot />
  </body>
</html>
